# Raiz do monorepo. Cada pacote (app/, server/, packages/*) tem o seu próprio .gitignore.
.dart_tool/
build/
coverage/
.idea/
*.iml
.DS_Store

# JDK baixado pela extensão Oracle Java do VS Code (não faz parte do projeto)
oracleJdk-27/

